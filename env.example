# Optional overrides. OpenQuant runs without creating a .env file.
POSTGRES_DB=openquant
POSTGRES_USER=openquant
POSTGRES_PASSWORD=openquant
# Only needed once when upgrading an existing installation that used a custom
# database password before the OpenQuant rename.
# LEGACY_POSTGRES_PASSWORD=replace-with-the-previous-password

# If omitted, unique values are generated and persisted in the app_data volume.
# Explicit values are useful when restoring or managing secrets externally:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
API_KEYS_ENCRYPTION_KEY=

# Set to 1 behind HTTPS so refresh cookies carry the Secure flag.
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Leave empty for the default same-origin deployment. Comma-separate explicit
# origins only when a separate frontend needs browser access.
CORS_ORIGINS=
ALLOWED_HOSTS=localhost,127.0.0.1

MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BYTES=12582912
WS_MAX_MESSAGE_BYTES=65536
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_MESSAGES_PER_MINUTE=120
WS_MAX_SUBSCRIPTIONS=20
MAX_CONCURRENT_SWEEPS=2

# Direct backend development outside Docker can use:
# DATABASE_URL=postgresql://openquant:openquant@127.0.0.1:5432/openquant

MAX_MARKET_OHLCV_CANDLES=8000
MARKET_RATE_LIMIT_MAX=120
MARKET_RATE_LIMIT_WINDOW_SEC=60

# Refresh the public symbol directory in the background when the app starts.
# Binance needs no key. Twelve Data additionally requires TWELVEDATA_API_KEY.
SEED_SYMBOLS_ON_STARTUP=1
SYMBOL_SEED_PROVIDERS=binance
TWELVEDATA_API_KEY=

# Local browser port.
OPENQUANT_PORT=8000
